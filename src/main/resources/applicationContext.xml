<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
          http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="orderDao" class="com.wileyedge.flooringmastery.dao.OrderDaoFileImpl"/>
    <bean id="productDao" class="com.wileyedge.flooringmastery.dao.ProductDaoFileImpl"/>
    <bean id="taxInfoDao" class="com.wileyedge.flooringmastery.dao.TaxInfoDaoFileImpl"/>
    <bean id="exportDao" class="com.wileyedge.flooringmastery.dao.ExportDaoFileImpl"/>
    <bean id="service" class="com.wileyedge.flooringmastery.service.ServiceLayerImpl">
        <constructor-arg ref="orderDao"/>
        <constructor-arg ref="productDao"/>
        <constructor-arg ref="taxInfoDao"/>
        <constructor-arg ref="exportDao"/>
    </bean>

    <bean id="console" class="com.wileyedge.flooringmastery.view.UserIOConsoleImpl"/>
    <bean id="view" class="com.wileyedge.flooringmastery.view.View">
        <constructor-arg ref="console"/>
    </bean>

    <bean id="controller" class="com.wileyedge.flooringmastery.controller.Controller">
        <constructor-arg ref="service"/>
        <constructor-arg ref="view"/>
    </bean>
</beans>